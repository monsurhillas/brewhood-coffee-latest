# Postgres connection string — set automatically when you attach a
# Postgres/Neon database to this project in the Vercel dashboard (Storage tab).
DATABASE_URL=

# Required by NextAuth to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the deployed app (Vercel sets this automatically in production
# via VERCEL_URL, but setting it explicitly avoids any ambiguity).
NEXTAUTH_URL=https://brewhood-coffee-latest.vercel.app

# Required for "Sign in with Google" on the manager dashboard. Create an
# OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, with this Authorized
# redirect URI added:
#   https://<your-production-domain>/api/auth/callback/google
# Until these are set, Google sign-in will fail — the username/password
# fallback login still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One-time setup key. After the database is attached, hit
#   POST /api/init?key=<INIT_SECRET>
# once to create the tables and a default manager login. Pick any long
# random string here — it does not need to be memorable.
INIT_SECRET=

# Required for the Bulk Upload (PDF OCR) tab. Get a FREE key (no credit
# card needed) at https://aistudio.google.com/apikey and paste it here —
# used server-side only, to read handwritten daily log sheets. Without
# this, every other feature works fine; only Bulk Upload will show a
# config error.
GEMINI_API_KEY=

# Optional — overrides which Gemini model reads the PDF. Defaults to
# gemini-3.6-flash if unset, which is covered by Google's free tier. Bump
# this later without a redeploy if Google retires the default model again.
GEMINI_MODEL=
